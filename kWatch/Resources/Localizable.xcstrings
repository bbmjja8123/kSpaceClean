        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用規約とプライバシーポリシーを見る"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看服务条款和隐私政策"
          }
        }
      }
    }
