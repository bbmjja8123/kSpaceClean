    "attr.notes.imessage.attachments": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected by system privacy; usually unreadable — and personal data even when visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのプライバシー保護対象で、通常は読み取れません。読めたとしても個人データです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受系统隐私保护，通常无法直接读取；即使可见也属个人数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受系統隱私保護，通常無法直接讀取；即使可見也屬個人資料。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 개인정보 보호로 보호되어 보통 읽을 수 없으며, 보이더라도 개인 데이터입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch die Privatsphäre des Systems geschützt; meist nicht lesbar — und selbst wenn sichtbar, persönliche Daten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégées par la confidentialité du système, généralement illisibles — et données personnelles même lorsqu’elles sont visibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegidos por la privacidad del sistema; normalmente ilegibles, y son datos personales incluso cuando se pueden ver."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegido pela privacidade do sistema; geralmente ilegível — e são dados pessoais mesmo quando visíveis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Protetti dalla privacy di sistema; di solito non sono leggibili — e sono comunque dati personali anche quando visibili."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищено приватностью системы; обычно нечитаемо, и даже видимым остаётся личными данными."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محمية بخصوصية النظام؛ عادةً غير قابلة للقراءة — وهي بيانات شخصية حتى عندما تكون مرئية."
          }
        }
      }
    },
    "attr.notes.ios.backups": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
