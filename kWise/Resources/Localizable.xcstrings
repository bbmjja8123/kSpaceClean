          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras escanear y limpiar, aquí aparecerá el historial de limpieza, con opción de revertir"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
