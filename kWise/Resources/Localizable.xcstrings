    "attr.anatomy.hero.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand first, act second — every item explains itself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に理解し、それから動く。すべての項目に理由があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先看懂，再动手。每一项都可展开理由、可拒答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先看懂，再動手。每一項都可展開理由、可拒答。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이해하고, 그다음 실행하세요. 모든 항목에 이유가 설명됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst verstehen, dann handeln — jedes Element erklärt sich selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprendre d’abord, agir ensuite — chaque élément s’explique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero entender, después actuar: cada elemento se explica por sí mismo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entenda primeiro, aja depois — cada item se explica por si."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima capire, poi agire — ogni elemento spiega se stesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала понять, потом действовать. У каждого элемента есть объяснение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افهم أولًا، ثم تصرّف — كل عنصر يشرح نفسه."
          }
        }
      }
    },
