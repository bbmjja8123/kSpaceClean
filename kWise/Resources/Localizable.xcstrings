    "assistant.answer.duplicates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate files appear grouped on the anatomy canvas — tap a group card to drill down and pick items. After a scan the newest original is kept automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复文件按组呈现在首屏画布上，点组卡进下钻页逐项勾选；扫描后会智能保留最新原件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複ファイルはグループごとにキャンバスに表示されます。グループカードから下位画面で1件ずつ選べます。スキャン後は最新の原本を自動的に残します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複檔案會以群組呈現首屏畫布，點群組卡進入下鑽頁逐項勾選；掃描後會自動保留最新原件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복 파일은 첫 화면 캔버스에 그룹으로 표시됩니다. 그룹 카드를 눌러 하위 화면에서 항목을 선택하세요. 스캔 후 최신 원본은 자동으로 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelte Dateien erscheinen gruppiert in der Übersicht — tippen Sie auf eine Gruppenkarte, um herunterzubrechen und Elemente auszuwählen. Nach dem Scan bleibt automatisch das neueste Original erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers dupliqués apparaissent regroupés sur la vue d’ensemble — touchez une carte de groupe pour détailler et sélectionner les éléments. Après une analyse, l’original le plus récent est conservé automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos duplicados aparecen agrupados en el panel: toca una tarjeta de grupo para descender y elegir elementos. Tras un escaneo se conserva automáticamente el original más reciente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos duplicados aparecem agrupados no painel de anatomia — toque em um cartão de grupo para detalhar e escolher itens. Após uma varredura, o original mais recente é mantido automaticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file duplicati compaiono raggruppati nel panorama — tocca la scheda di un gruppo per approfondire e selezionare gli elementi. Dopo una scansione viene conservata automaticamente la copia più recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дубликаты показаны группами на холсте первого экрана — нажмите карточку группы, чтобы перейти внутрь и выбрать элементы. После сканирования автоматически сохраняется самый свежий оригинал."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الملفات المكررة مجمّعة على اللوحة التشريحية — انقر بطاقة مجموعة للانتقال إليها واختيار العناصر. بعد الفحص يُحتفظ تلقائيًا بأحدث نسخة أصلية."
          }
        }
      }
    },
