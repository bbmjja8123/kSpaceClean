    "history.forecast.insufficientData": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough samples yet — keep using Klaris for a few days and a forecast will appear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "样本不足 — 继续使用 Klaris 几天后即可生成预测。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルが不足しています — Klaris を数日使い続けると予測が表示されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "樣本不足——再使用 Klaris 幾天後即可產生預測。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 샘플이 부족합니다 — Klaris를 며칠 더 사용하면 예측이 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht genügend Messwerte — benutzen Sie Klaris noch einige Tage, dann erscheint eine Prognose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore assez d’échantillons — continuez à utiliser Klaris quelques jours et une prévision apparaîtra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay muestras suficientes: sigue usando Klaris unos días y aparecerá una previsión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há amostras suficientes — continue usando o Klaris por alguns dias e uma previsão aparecerá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora pochi campioni — continua a usare Klaris per qualche giorno e apparirà una previsione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данных пока мало — пользуйтесь Klaris ещё несколько дней, и появится прогноз."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد عينات كافية بعد — واصل استخدام Klaris بضعة أيام وسيظهر تنبؤ."
          }
        }
      }
    },
    "history.forecast.stable": {
      "localizations": {
