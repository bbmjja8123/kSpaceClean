    "settings.rules.listSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See every rule behind each attribution: matched paths, ownership, and how space is reclaimed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐条查看每条归因判断依据的规则：匹配路径、归属与回收方式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各帰属判断の根拠となるルールを1件ずつ確認できます。マッチしたパス・帰属先・回収方法を表示します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐條查看每項歸因判斷依據的規則：符合路徑、歸屬與回收方式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 원인 분석 판정의 근거가 되는 규칙을 항목별로 확인하세요: 일치 경로, 소유자, 회수 방식."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Regeln hinter jeder Ursachenanalyse ansehen: zutreffende Pfade, Eigentümerschaft und wie Speicherplatz zurückgewonnen wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez chaque règle derrière chaque analyse des causes: chemins reconnus, propriété et façon de récupérer l’espace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta todas las reglas detrás de cada análisis de causas: rutas coincidentes, propiedad y cómo se recupera el espacio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja cada regra por trás de cada atribuição: caminhos correspondentes, propriedade e como o espaço é liberado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi ogni regola dietro ogni analisi: percorsi corrispondenti, proprietà e come lo spazio viene recuperato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите каждое правило, на котором строится вывод: совпадающие пути, принадлежность и способ освобождения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلع على كل قاعدة وراء كل تحليل: المسارات المطابقة والملكية وكيفية استرداد المساحة."
          }
        }
      }
    },
    "ob3.promiseTitle": {
