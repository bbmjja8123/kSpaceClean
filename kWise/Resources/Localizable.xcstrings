    "attr.rehearsal.banner": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything below moves to the Trash — uncheck any line; nothing runs until you confirm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下はゴミ箱へ移動される全内容です。項目ごとに解除でき、確認後に実行されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下是将要移入废纸篓的全部内容，可逐项取消勾选；确认后才执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以下是將移入垃圾桶的全部內容，可逐項取消勾選；確認後才會執行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래는 휴지통으로 이동할 전체 목록입니다. 항목별로 선택을 해제할 수 있으며, 확인 전에는 실행되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles unten landet im Papierkorb — einzelne Zeilen lassen sich abwählen; nichts wird ausgeführt, bevor Sie bestätigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui suit ira à la Corbeille — décochez une ligne au besoin ; rien ne s’exécute avant votre confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo de abajo se mueve a la Papelera; desmarca cualquier línea. No se ejecuta nada hasta que lo confirmes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo abaixo vai para a Lixeira — desmarque qualquer linha; nada é executado até você confirmar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che segue va nel Cestino — deseleziona qualsiasi riga; nulla viene eseguito finché non confermi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниже — всё, что будет перемещено в Корзину. Любую строку можно снять с выбора; ничего не выполняется до подтверждения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما يلي يُنقل إلى المهملات — ألغِ تحديد أي سطر؛ لا يُنفَّذ شيء قبل تأكيدك."
          }
        }
      }
    },
