    "attr.blackbox.uncovered.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %@ lies outside this scan's coverage (your documents, photos, apps and system areas) — not junk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %@ 在本次扫描范围之外（你的文档、照片、应用与系统区域）——不是垃圾"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約 %@ はこのスキャンの範囲外です（書類・写真・アプリ・システム領域）——ゴミではありません"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "約 %@ 在本次掃描範圍之外（你的文件、照片、App 與系統區域）——不是垃圾"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %@은(는) 이번 스캔 범위 밖에 있습니다(문서, 사진, 앱, 시스템 영역) — 정크가 아닙니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %@ liegen außerhalb der Abdeckung dieses Scans (Ihre Dokumente, Fotos, Apps und Systembereiche) — kein Müll."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %@ se trouve hors du périmètre de cette analyse (vos documents, photos, applications et zones système) — ce ne sont pas des déchets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alrededor de %@ queda fuera de la cobertura de este escaneo (documentos, fotos, aplicaciones y áreas del sistema): no es basura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de %@ está fora da cobertura desta varredura (seus documentos, fotos, apps e áreas do sistema) — não é lixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %@ non rientra nella copertura di questa scansione (documenti, foto, app e aree di sistema) — non è spazzatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Около %@ находится вне зоны этого сканирования (ваши документы, фото, приложения и системные области) — это не мусор."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحو %@ يقع خارج تغطية هذا الفحص (مستنداتك وصورك وتطبيقاتك ومناطق النظام) — وليست ملفات غير مرغوبة."
          }
        }
      }
    },
