    "widget.config.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See Mac storage usage, the last cleanup and your streak. Tap to run Smart Care."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のストレージ使用量・前回のクリーンアップ・連続記録を確認。タップで Smart Care を実行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Mac 存储占用、上次清理与连续打卡。点击即可运行 Smart Care。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Mac 儲存空間佔用、上次清理與連續打卡。點按即可執行智慧清理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 저장 공간 사용량, 최근 정리, 연속 기록을 확인합니다. 눌러서 스마트 케어를 실행하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichernutzung des Mac, letzte Bereinigung und Ihre Serie ansehen. Zum Starten von Smart Care tippen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l’occupation du stockage du Mac, le dernier nettoyage et votre série. Touchez pour lancer Smart Care."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el uso del almacenamiento del Mac, la última limpieza y tu racha. Toca para ejecutar Smart Care."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o uso de armazenamento do Mac, a última limpeza e sua sequência. Toque para executar o Smart Care."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi l'uso dello storage del Mac, l'ultima pulizia e la tua serie. Tocca per avviare Smart Care."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите заполнение хранилища Mac, последнюю очистку и вашу серию. Нажмите, чтобы запустить умную очистку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلع على استخدام تخزين الـ Mac وآخر تنظيف وسلسلتك. انقر لتشغيل العناية الذكية."
          }
        }
      }
    },
