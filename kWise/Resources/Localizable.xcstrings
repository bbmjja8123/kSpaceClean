            "state": "translated",
            "value": "التدمير الآمن للملفات"
          }
        }
      }
    },
    "shred.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overwrite file contents, then move to the Trash so sensitive files cannot be recovered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆写文件内容后移入废纸篓，确保敏感文件无法恢复"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの内容を上書きしてからゴミ箱へ移動し、機密ファイルが復元されないようにします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覆寫檔案內容後移入垃圾桶，確保敏感檔案無法復原"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 내용을 덮어쓴 뒤 휴지통으로 이동해 민감한 파일을 복구할 수 없게 합니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreibt Dateiinhalte und verschiebt die Dateien anschließend in den Papierkorb, damit vertrauliche Dateien nicht wiederhergestellt werden können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrase le contenu des fichiers, puis les déplace à la Corbeille afin que les fichiers sensibles soient irrécupérables."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescribe el contenido de los archivos y los mueve después a la Papelera, de modo que los archivos sensibles no se puedan recuperar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescreve o conteúdo dos arquivos e depois os move para a Lixeira, para que arquivos sensíveis não possam ser recuperados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrascrive il contenuto dei file, poi li sposta nel Cestino così i file sensibili non possono essere recuperati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое файлов перезаписывается, затем они перемещаются в Корзину, чтобы конфиденциальные файлы нельзя было восстановить"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب فوق محتويات الملفات، ثم انقلها إلى المهملات حتى لا تُستعاد الملفات الحساسة."
          }
        }
      }
    },
