    "emptyState.firstLaunch.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise scans your Mac for files that are safe to clean and shows you a detailed list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise は Mac 内の安全に整理できるファイルをスキャンし、詳しいリストを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise 会扫描你 Mac 上可以安全清理的文件，给你一个详细列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise 會掃描你 Mac 上可以安全清理的檔案，並給你一份詳細列表。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise는 Mac에서 안전하게 정리할 수 있는 파일을 스캔해 자세한 목록을 보여줍니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise durchsucht Ihren Mac nach Dateien, die sich sicher bereinigen lassen, und zeigt Ihnen eine detaillierte Liste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise analyse votre Mac à la recherche de fichiers nettoyables sans risque et vous en présente une liste détaillée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise escanea el Mac en busca de archivos que se pueden limpiar con seguridad y muestra una lista detallada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O kWise varre seu Mac em busca de arquivos que podem ser limpos com segurança e mostra uma lista detalhada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise scansiona il tuo Mac alla ricerca di file pulibili in sicurezza e ti mostra un elenco dettagliato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise сканирует Mac на предмет файлов, которые можно безопасно очистить, и показывает подробный список."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص kWise جهاز Mac لديك بحثًا عن ملفات آمنة للتنظيف ويعرض لك قائمة مفصلة."
          }
        }
      }
    },
