        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito pelo Klaris diretamente — movido para a Lixeira, restaurável."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguito direttamente da Klaris — spostato nel Cestino, ripristinabile."
