    "onboarding.page2.privacyNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All scanning and attribution happen on this Mac — nothing is reported."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンも帰属分析もすべてこの Mac 上で完結。データ送信はゼロです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有扫描与归因均在本机完成，零数据上报。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有掃描與歸因均在本機完成，零資料上報。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 스캔과 원인 분석은 이 Mac에서 이루어지며, 데이터를 수집하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sämtliches Scannen und die Ursachenanalyse geschehen auf diesem Mac — nichts wird gemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les analyses et l’analyse des causes se font sur ce Mac — rien n’est transmis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el escaneo y el análisis de causas ocurren en este Mac: no se informa de nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a varredura e a análise de causas acontecem neste Mac — nada é reportado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta la scansione e l'analisi delle cause avvengono su questo Mac — nessun dato viene riportato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все сканирование и определение причин выполняются на этом Mac — никакой отправки данных."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل الفحص وتحليل الأسباب يجري على هذا الـ Mac — لا شيء يُبلَّغ عنه."
          }
        }
      }
    },
    "paywall.direct.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The direct edition has no in-app purchase. Open the Mac App Store, search for Klaris, and unlock reclamation actions with a one-time purchase; scanning, attribution and the refusal list stay free forever in every edition."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直営版にはアプリ内課金がありません。Mac App Store で Klaris を検索して、買い切りで回収アクションを解放できます。スキャン・帰属・拒否リストはすべてのエディションで永久無料です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直营版不提供内购。打开 Mac App Store 搜索 Klaris，一次买断解锁回收动作；扫描、归因与拒答清单在所有版本永久免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直營版不提供 App 內購買。打開 Mac App Store 搜尋 Klaris，一次買斷解鎖回收動作；掃描、歸因與拒答清單在所有版本永久免費。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직영 버전에는 앱 내 구매가 없습니다. Mac App Store에서 Klaris를 검색해 일회성 구매로 회수 동작을 잠금 해제하세요. 스캔, 원인 분석, 거부 목록은 모든 버전에서 영구 무료입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Direct-Edition hat keinen In-App-Kauf. Öffnen Sie den Mac App Store, suchen Sie nach Klaris und schalten Sie die Aufräumaktionen per Einmalkauf frei; Scannen, Ursachenanalyse und die Liste der Ablehnungen bleiben in jeder Edition dauerhaft kostenlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’édition directe n’a pas d’achat intégré. Ouvrez le Mac App Store, cherchez Klaris et déverrouillez les actions de récupération avec un achat unique ; l’analyse, l’analyse des causes et la liste de refus restent gratuites pour toujours dans toutes les éditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edición directa no tiene compras dentro de la aplicación. Abre el Mac App Store, busca Klaris y desbloquea las acciones de recuperación con una compra única; el escaneo, el análisis de causas y la lista de rechazo siguen siendo gratis para siempre en todas las ediciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A edição direta não tem compra dentro do app. Abra a Mac App Store, procure por Klaris e desbloqueie as ações de liberação com uma compra única; a varredura, a análise de causas e a lista de recusas permanecem gratuitas para sempre em todas as edições."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'edizione diretta non ha acquisti in-app. Apri il Mac App Store, cerca Klaris e sblocca le azioni di recupero con un acquisto una tantum; scansione, analisi delle cause e lista dei rifiuti restano gratuite per sempre in ogni edizione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В прямой версии покупок внутри приложения нет. Откройте Mac App Store, найдите Klaris и разовой покупкой разблокируйте действия по освобождению места; сканирование, определение причин и список отказов остаются бесплатными навсегда во всех версиях."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شراء داخل التطبيق في الإصدار المباشر. افتح Mac App Store، وابحث عن Klaris، وافتح إجراءات الاسترداد بشراء لمرة واحدة؛ يبقى الفحص وتحليل الأسباب وقائمة الرفض مجانيين للأبد في كل الإصدارات."
          }
        }
      }
    },
