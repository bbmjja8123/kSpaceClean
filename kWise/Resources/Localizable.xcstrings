    "100% 本地处理，零数据上报": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processed 100% on-device. Zero data collection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて本機で処理。データ収集は一切ありません。"
          }
        },
