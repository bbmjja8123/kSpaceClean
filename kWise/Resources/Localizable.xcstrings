        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez l’accès pour analyser l’historique des navigateurs, les cookies et l’historique de téléchargement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede acceso para escanear historial del navegador, cookies y registros de descargas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acesso para examinar histórico de navegadores, cookies e registros de downloads."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi l'accesso per scansionare cronologia dei browser, cookie e record di download."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставьте доступ, чтобы сканировать историю браузера, cookie и загрузки."
