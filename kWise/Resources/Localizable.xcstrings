      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These look like backup copies of \"%@\" — one hasn't changed in %lld days, like an older backup of the same project"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来是「%@」相关的备份副本——其中一个已经 %lld 天没有更新，像是同一项目的旧备份"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」関連のバックアップコピーのようです — 片方は %lld 日間更新されておらず、同じプロジェクトの古いバックアップのようです"
          }
        }
      }
