          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次買斷 ¥68（$9.90）· 無訂閱 · 掃描與歸因永遠免費 · 資料不出機"
          }
        },
        "ko": {
