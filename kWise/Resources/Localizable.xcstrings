    "ob3.firstScanSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first scan starts as soon as you finish, finding space you can reclaim"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成后立即开始第一次扫描，发现可清理的空间"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了するとすぐに最初のスキャンを開始し、整理できるスペースを見つけます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成後立即開始第一次掃描，找出可清理的空間"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마치는 즉시 첫 스캔이 시작되어 정리할 수 있는 공간을 찾아냅니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Scan startet, sobald Sie fertig sind, und findet Speicherplatz, den Sie zurückgewinnen können"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première analyse démarre dès que vous terminez, pour repérer l’espace que vous pouvez récupérer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer escaneo empieza en cuanto termines, y encuentra espacio que se puede recuperar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira varredura começa assim que você terminar, encontrando espaço que você pode liberar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima scansione parte appena hai finito, trovando lo spazio che puoi recuperare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как только вы закончите, начнётся первое сканирование и найдёт место, которое можно освободить"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ الفحص الأول بمجرد انتهائك، ليجد المساحة التي يمكنك استردادها"
          }
        }
      }
    },
