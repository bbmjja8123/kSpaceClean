    "diskhealth.smart.subtitle.verified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The storage controller self-test passed. No action needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储控制器自检通过。无需立即操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージコントローラのセルフテストに合格しました。対応は不要です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存控制器自我測試通過。無需採取行動。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 컨트롤러 자가 진단을 통과했습니다. 조치가 필요하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Selbsttest des Speicher-Controllers wurde bestanden. Keine Maßnahmen nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autotest du contrôleur de stockage est réussi. Aucune action nécessaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autocomprobación del controlador de almacenamiento pasó. No hace falta ninguna acción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O autoteste do controlador de armazenamento passou. Nenhuma ação é necessária."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autotest del controller di archiviazione è superato. Nessuna azione necessaria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самотестирование контроллера хранилища пройдено. Действий не требуется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نجح الاختبار الذاتي لوحدة التحكم في التخزين. لا حاجة لأي إجراء."
          }
        }
      }
    },
    "diskhealth.smart.subtitle.failing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The storage controller self-test failed. Back up important data now and contact Apple Support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储控制器自检失败。建议立即备份重要数据并联系 Apple 支持。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージコントローラのセルフテストに失敗しました。重要なデータをすぐにバックアップし、Apple サポートにご相談ください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存控制器自我測試失敗。建議立即備份重要資料並聯絡 Apple 支援。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 컨트롤러 자가 진단에 실패했습니다. 지금 중요한 데이터를 백업하고 Apple 지원에 문의하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Selbsttest des Speicher-Controllers ist fehlgeschlagen. Sichern Sie jetzt wichtige Daten und wenden Sie sich an den Apple Support."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autotest du contrôleur de stockage a échoué. Sauvegardez vos données importantes maintenant et contactez l’assistance Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autocomprobación del controlador de almacenamiento falló. Haz ahora una copia de seguridad de los datos importantes y contacta con el Soporte de Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O autoteste do controlador de armazenamento falhou. Faça backup dos dados importantes agora e contate o Suporte da Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autotest del controller di archiviazione non è andato a buon fine. Fai subito un backup dei dati importanti e contatta il supporto Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самотестирование контроллера хранилища не пройдено. Сейчас же сохраните важные данные и обратитесь в поддержку Apple."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الاختبار الذاتي لوحدة التحكم في التخزين. خذ نسخة احتياطية لبياناتك المهمة الآن وتواصل مع دعم Apple."
          }
        }
      }
    },
    "diskhealth.smart.subtitle.notSupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This controller does not provide S.M.A.R.T. data."
          }
        },
        "zh-Hans": {
