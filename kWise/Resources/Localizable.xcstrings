        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直营版直接运行于你的 Mac 上，可扫描完整磁盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直營版不在沙盒內執行，可掃描完整磁碟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직영 버전은 샌드박스 없이 Mac에서 실행되며 전체 디스크를 스캔할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Direct-Edition läuft ohne Sandbox auf Ihrem Mac und kann die gesamte Festplatte scannen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’édition directe s’exécute sans bac à sable sur votre Mac et peut analyser l’ensemble du disque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edición directa se ejecuta sin sandbox en el Mac y puede escanear todo el disco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A edição direta roda sem sandbox no seu Mac e pode examinar o disco completo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'edizione diretta gira senza sandbox sul tuo Mac e può scansionare l'intero disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямая версия работает без песочницы и может сканировать весь диск."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل الإصدار المباشر دون صندوق حماية على جهاز Mac لديك ويمكنه فحص القرص كاملًا."
          }
        }
      }
    },
