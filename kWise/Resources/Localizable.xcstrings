    "settings.startup.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and disable user-level launch items; system-level items come with manual guidance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーレベルの起動項目を確認・無効化します。システムレベルの項目は手順をご案内します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看并停用用户级启动项；系统级项目提供手动指引。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看並停用使用者層級的啟動項目；系統層級項目提供手動指引。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 수준 시작 항목을 검토하고 비활성화합니다. 시스템 수준 항목은 수동 안내를 제공합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startobjekte auf Benutzerebene prüfen und deaktivieren; Objekte auf Systemebene kommen mit manueller Anleitung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez et désactivez les éléments d’ouverture au niveau utilisateur ; les éléments système s’accompagnent d’un guide manuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa y desactiva elementos de lanzamiento del usuario; los del sistema incluyen guía manual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise e desative itens de inicialização do usuário; itens do sistema vêm com orientação manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivedi e disattiva gli elementi di avvio a livello utente; quelli a livello di sistema prevedono una guida manuale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте и отключайте объекты запуска пользователя; для системных есть ручные инструкции."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع وأوقف عناصر التشغيل على مستوى المستخدم؛ والعناصر على مستوى النظام تأتي مع إرشادات يدوية."
          }
        }
      }
    },
