    "覆写文件内容后移入废纸篓，确保敏感文件无法恢复": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overwrites file contents before moving to the Trash, so sensitive files can't be recovered"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱へ移動する前にファイル内容を上書きし、機密ファイルを復元できなくします"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆写文件内容后移入废纸篓，确保敏感文件无法恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覆寫檔案內容後移入垃圾桶，確保敏感檔案無法復原"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 내용을 덮어쓴 뒤 휴지통으로 이동시켜 민감한 파일을 복구할 수 없게 합니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreibt Dateiinhalte, bevor sie in den Papierkorb verschoben werden, sodass vertrauliche Dateien nicht wiederhergestellt werden können"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrase le contenu des fichiers avant de les déplacer à la Corbeille, afin que les fichiers sensibles soient irrécupérables"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescribe el contenido de los archivos antes de moverlos a la Papelera, de modo que los archivos sensibles no se puedan recuperar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescreve o conteúdo dos arquivos antes de movê-los para a Lixeira, para que arquivos sensíveis não possam ser recuperados"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrascrive il contenuto dei file prima di spostarli nel Cestino, così i file sensibili non possono essere recuperati"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое файлов перезаписывается перед перемещением в Корзину, чтобы конфиденциальные файлы нельзя было восстановить"
