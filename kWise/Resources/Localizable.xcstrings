          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les données S.M.A.R.T. — l’accès complet au disque est généralement requis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
