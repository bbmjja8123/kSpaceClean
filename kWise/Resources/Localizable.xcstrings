    "settings.privacy.browserTracesSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans browser history, cookies, caches, and expired system logs — everything stays on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描浏览器历史、Cookie、缓存与过期系统日志，全部在本机完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザの履歴・Cookie・キャッシュ・期限切れのシステムログをスキャンします。処理はすべてこの Mac 上で完結します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描瀏覽記錄、Cookie、快取與過期系統日誌，全部在本機完成。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 방문 기록, 쿠키, 캐시, 만료된 시스템 로그를 스캔합니다 — 모두 이 Mac에서 처리됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannt Browserverlauf, Cookies, Caches und abgelaufene Systemprotokolle — alles bleibt auf diesem Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse l’historique des navigateurs, les cookies, les caches et les journaux système expirés — tout reste sur ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea historial del navegador, cookies, cachés y registros del sistema caducados: todo se queda en este Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Examina histórico de navegadores, cookies, caches e logs do sistema expirados — tudo fica neste Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona cronologia dei browser, cookie, cache e log di sistema scaduti — tutto resta su questo Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирует историю браузера, cookie, кэши и просроченные системные журналы — всё на этом Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص سجل المتصفح وملفات تعريف الارتباط والذاكرات المؤقتة وسجلات النظام المنتهية — كل شيء يبقى على هذا الـ Mac."
          }
        }
      }
    },
