          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche eseguire prima una scansione Smart Care — la mappa mostrerà quindi ogni categoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
