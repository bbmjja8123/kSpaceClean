    "onboarding.grant.directBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This edition runs directly on your Mac and can read the full disk for scanning. Nothing is uploaded — scanning happens entirely on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエディションは Mac 上で直接動作し、ディスク全体を読み取ってスキャンできます。ファイルのアップロードは行われず、スキャンはすべて本機で完結します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本直接运行于你的 Mac 上，可读取完整磁盘完成扫描。文件不会被上传，扫描全部在本机完成。"
          }
        }
      }
    },
