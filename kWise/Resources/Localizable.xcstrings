    "privacy.overview.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise only lists what it can actually handle; everything else links straight to System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise 只列出它能实际处理的项目；其余项会直接带你去系统设置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise は実際に処理できる項目だけを表示し、それ以外はシステム設定へ直接ご案内します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise 只列出它能實際處理的項目；其餘項目會直接帶你前往系統設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise는 실제로 처리할 수 있는 항목만 표시하며, 나머지는 바로 시스템 설정으로 안내합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise listet nur, was es tatsächlich verarbeiten kann; alles andere verlinkt direkt in die Systemeinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise ne liste que ce qu’il peut réellement traiter ; tout le reste renvoie directement aux Réglages Système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise solo enumera lo que puede gestionar de verdad; todo lo demás enlaza directamente con Ajustes del Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O kWise lista apenas o que realmente pode tratar; todo o resto leva direto aos Ajustes do Sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise elenca solo ciò che può effettivamente gestire; tutto il resto rimanda direttamente a Impostazioni di Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise перечисляет только то, что действительно может обработать; остальное открывается прямо в Системных настройках."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسرد kWise فقط ما يمكنه معالجته فعليًا؛ وكل ما عدا ذلك يرتبط مباشرة بإعدادات النظام."
          }
        }
      }
    },
