    "canvas.quickclean.failedRetry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup couldn't finish — please try again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンアップを完了できませんでした。もう一度お試しください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理未能完成，请重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理未能完成，請重試"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리를 완료하지 못했습니다 — 다시 시도해 주세요"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bereinigung konnte nicht abgeschlossen werden — bitte versuchen Sie es erneut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage n’a pas pu aboutir — veuillez réessayer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza no se pudo completar; inténtalo de nuevo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza não pôde ser concluída — tente novamente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulizia non è stata completata — riprova"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистку не удалось завершить — попробуйте ещё раз"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إكمال التنظيف — يرجى المحاولة مجددًا"
          }
        }
      }
    },
    "canvas.status.containerOnly.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant your home folder so most junk files can be found and cleaned."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームフォルダを許可すると、ほとんどの不要ファイルを検出・整理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权主目录后才能发现并清理大部分垃圾文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權主目錄後，才能找出並清理大部分垃圾檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 폴더 권한을 허용하면 대부분의 정크 파일을 찾아 정리할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilen Sie Zugriff auf Ihren Benutzerordner, damit die meisten Mülldateien gefunden und bereinigt werden können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez votre dossier personnel pour que la plupart des déchets puissent être repérés et nettoyés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede el acceso a la carpeta de inicio para que se puedan encontrar y limpiar la mayoría de archivos de basura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda sua pasta pessoal para que a maioria dos arquivos de lixo possa ser encontrada e limpa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi la cartella home così la maggior parte dei file indesiderati può essere trovata e pulita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставьте доступ к домашней папке, чтобы можно было находить и очищать большую часть мусорных файлов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح الوصول إلى مجلدك الرئيسي ليكون بالإمكان العثور على معظم الملفات غير المرغوبة وتنظيفها."
          }
        }
      }
    },
    "canvas.status.fullAccess.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The direct edition can scan the full disk directly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直営版はディスク全体を直接スキャンできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直营版可直接扫描完整磁盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直營版可直接掃描完整磁碟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직영 버전은 전체 디스크를 직접 스캔할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Direct-Edition kann die gesamte Festplatte direkt scannen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’édition directe peut analyser l’ensemble du disque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edición directa puede escanear todo el disco directamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A edição direta pode examinar o disco completo diretamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'edizione diretta può scansionare l'intero disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямая версия может сканировать весь диск напрямую."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للإصدار المباشر فحص القرص كاملًا مباشرة."
          }
