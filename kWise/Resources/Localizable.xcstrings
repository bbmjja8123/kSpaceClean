    "assistant.answer.appLeftovers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-item leftover handling will return in a later release; this version does not touch your app data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用残留的逐项处理界面将在后续版本回归；本版本不会动你的应用数据。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残留ファイルの個別処理は今後のバージョンで復活予定です。このバージョンではアプリのデータには触れません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 殘留的逐項處理介面將在後續版本回歸；本版本不會更動你的 App 資料。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 잔여 파일의 항목별 처리는 이후 버전에서 다시 제공됩니다. 이 버전은 앱 데이터를 건드리지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Umgang mit einzelnen Elementen folgt in einer späteren Version; diese Version berührt Ihre App-Daten nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La gestion individuelle des restants d’applications reviendra dans une version ultérieure ; cette version ne touche pas aux données de vos applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tratamiento residuo a residuo volverá en una versión posterior; esta versión no toca los datos de las aplicaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tratamento item por item de resíduos voltará em uma versão futura; esta versão não toca nos dados dos seus apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La gestione dei residui singoli tornerà in una versione futura; questa versione non tocca i dati delle tue app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поработка с остаточными файлами по отдельности вернётся в будущей версии; эта версия не трогает данные ваших приложений."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستعود معالجة البقايا لكل عنصر في إصدار لاحق؛ هذا الإصدار لا يلمس بيانات تطبيقاتك."
          }
        }
      }
    },
