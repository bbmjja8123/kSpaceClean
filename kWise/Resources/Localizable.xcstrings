    "emptyState.noFDA.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise needs Full Disk Access to scan every cleanable file on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise が Mac 内の整理可能なファイルをすべてスキャンするには、フルディスクアクセスが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise 需要 Full Disk Access 才能扫描你 Mac 上的所有可清理文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise 需要完整磁碟存取權限，才能掃描你 Mac 上所有可清理的檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise가 Mac의 모든 정리 가능 파일을 스캔하려면 전체 디스크 접근 권한이 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise benötigt Vollzugriff auf die Festplatte, um jede bereinigbare Datei auf Ihrem Mac zu scannen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise a besoin de l’accès complet au disque pour analyser tous les fichiers nettoyables de votre Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise necesita el Acceso total al disco para escanear todos los archivos limpiables del Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O kWise precisa do Acesso Total ao Disco para examinar todos os arquivos limpáveis do seu Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise ha bisogno dell'Accesso completo al disco per scansionare ogni file pulibile del tuo Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сканирования всех очищаемых файлов на Mac приложению kWise нужен полный доступ к диску."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج kWise إلى الوصول الكامل إلى القرص لفحص كل ملف قابل للتنظيف على جهاز Mac لديك."
          }
        }
      }
    },
