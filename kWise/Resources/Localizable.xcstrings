    "settings.unlock.plan.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning, attribution and the refusal list are free forever; reclamation actions unlock with a one-time purchase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン・帰属・拒否リストは永久無料。回収アクションは買い切りで解放されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描、归因、拒答清单永久免费；回收动作一次买断解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描、歸因、拒答清單永久免費；回收動作一次買斷解鎖。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔, 원인 분석, 거부 목록은 영구 무료이며, 회수 동작은 일회성 구매로 잠금 해제됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen, Ursachenanalyse und die Liste der Ablehnungen sind dauerhaft kostenlos; Aufräumaktionen werden per Einmalkauf freigeschaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse, l’analyse des causes et la liste de refus sont gratuites pour toujours ; les actions de récupération se déverrouillent avec un achat unique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
