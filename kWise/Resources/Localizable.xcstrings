    "assistant.answer.shredHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shredding overwrites the file contents first (one pass is enough on SSDs), then randomizes the names and moves them to the Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件粉碎先覆写内容（SSD 一次覆写已足够），再随机化文件名并移入废纸篓。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル粉砕はまず内容を上書きし（SSDでは1回で十分）、名前をランダム化してからゴミ箱へ移動します。"
          }
        }
      }
    },
    "assistant.card.shred.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File shredding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件粉碎"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル粉砕"
          }
        }
      }
    },
    "assistant.card.shred.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the \"＋\" menu or drag files into the window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首屏「+」菜单或把文件拖进窗口即可粉碎"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の「＋」メニューか、ファイルをウィンドウへドラッグして実行できます"
          }
        }
      }
    },
    "assistant.answer.cleanupNow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the safe quick-clean button on the anatomy canvas to scan and clean recommended items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击首屏的「安全快捷回收」按钮，即可扫描并清理推荐项。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスの「安全なクイッククリーン」ボタンをタップすると、推奨項目をスキャンして整理します。"
          }
        }
      }
    },
    "assistant.answer.similarPhotos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar photos appear grouped on the anatomy canvas: on-device perceptual matching finds screenshot piles, keeping at least one per group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相似照片按组呈现在首屏画布上：本机感知比对找出截图堆积，每组至少保留一张。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "類似写真はキャンバスにグループで表示されます。端末内の知覚マッチングでスクリーンショットの山を見つけ、各グループで必ず1枚を残します。"
          }
        }
      }
    },
    "assistant.card.photos.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相似照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "類似写真"
          }
        }
      }
    },
    "assistant.card.photos.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perceptual hashing, matched on-device, no network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感知哈希找出相似照片，本机比对不联网"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知覚ハッシュで類似写真を検出。端末内で照合し、ネット接続は不要"
          }
        }
      }
    },
    "assistant.answer.freeUpSpace": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three steps to free space: ① quick-clean the recommended items ② find huge files under Large Files ③ clear screenshot piles under Similar Photos. Everything goes to the Trash and is restorable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三步腾空间：① 首屏「安全快捷回收」清推荐项 ② 大文件找巨型文件 ③ 相似照片清截图。全部走废纸篓可还原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3ステップで容量を確保：① クイッククリーンで推奨項目を整理 ② 大きなファイルで巨大ファイルを確認 ③ 類似写真でスクリーンショットを整理。すべてゴミ箱経由で復元可能です。"
          }
        }
      }
    },
    "assistant.answer.restoreLastCleanup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The History timeline groups cleanups by run — a whole run can be rolled back within 30 days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「历史」时间线按清理批次分组，单次清理可整体回滚（30 天内）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「履歴」のタイムラインはクリーンアップを実行ごとにグループ化し、30日以内なら一括で元に戻せます。"
          }
        }
      }
    },
