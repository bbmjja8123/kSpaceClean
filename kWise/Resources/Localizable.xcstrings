        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮어쓰기 검증 실패: %@에 0이 아닌 바이트가 남아 있습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreibungsprüfung fehlgeschlagen: %@ enthält weiterhin Bytes ungleich null"
