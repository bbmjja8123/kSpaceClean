    "Finder 可将 30 天内移入废纸篓的文件放回原位置": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder can put files trashed within 30 days back where they came from."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder は 30 日以内にゴミ箱へ移動したファイルを元の場所に戻せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 可将 30 天内移入废纸篓的文件放回原位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 可將 30 天內移入垃圾桶的檔案放回原位"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder는 30일 이내에 휴지통으로 이동한 파일을 원래 위치로 되돌릴 수 있습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder kann Dateien, die in den letzten 30 Tagen in den Papierkorb verschoben wurden, an ihren ursprünglichen Ort zurücklegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder peut remettre à leur emplacement d’origine les fichiers mis à la Corbeille depuis moins de 30 jours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder puede devolver a su ubicación original los archivos enviados a la Papelera en los últimos 30 días."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Finder pode devolver aos lugares de origem os arquivos movidos para a Lixeira nos últimos 30 dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Finder può riportare nella posizione originale i file spostati nel Cestino negli ultimi 30 giorni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder может вернуть на место файлы, перемещённые в Корзину за последние 30 дней"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Finder إعادة الملفات التي أُرسلت إلى المهملات خلال آخر 30 يومًا إلى مواضعها الأصلية."
          }
        }
      }
    },
