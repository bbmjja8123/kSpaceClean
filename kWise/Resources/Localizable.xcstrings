    "attr.notes.ai.models-intelligence": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System-managed AI models. Downloads and enablement are controlled in System Settings; this app will not — and cannot — delete them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム管理の AI モデルです。ダウンロードと有効化はシステム設定で管理され、本アプリは削除できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统管理的 AI 模型，下载与启用由系统设置控制；本应用不会也无法删除它。"
          }
        }
      }
    },
    "attr.notes.caches.app-generic": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App caches — the classic 'deletes itself back': usually rebuilt within days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのキャッシュ。「削除すると戻ってくる」代表例です。通常は数日で再生成されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用缓存。这是「删了又回来」的典型：通常数天内按需重建。"
          }
        }
      }
    },
    "attr.notes.dingtalk.files": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work and chat data are personal data; no deletion advice is given."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "業務・チャットデータは個人データです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "办公与聊天数据属个人数据；本应用不给删除建议。"
          }
        }
      }
    },
    "attr.notes.docker.disk-image": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker's VM disk: deleting it removes every image and container. This is data deletion, not junk cleanup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker の仮想ディスクです。削除すると全イメージとコンテナが失われます。これはデータ削除であり、ゴミ掃除ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 虚拟磁盘：删除会连带删除全部镜像与容器。这是数据删除，不是垃圾清理。"
          }
        }
      }
    },
    "attr.notes.feishu.files": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collaboration and chat data are personal data; no deletion advice is given."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コラボレーションとチャットのデータは個人データです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协作与聊天数据属个人数据；本应用不给删除建议。"
          }
        }
      }
    },
    "attr.notes.imessage.attachments": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected by system privacy; usually unreadable — and personal data even when visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのプライバシー保護対象で、通常は読み取れません。読めたとしても個人データです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受系统隐私保护，通常无法直接读取；即使可见也属个人数据。"
          }
        }
      }
    },
    "attr.notes.ios.backups": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-device backups. Once deleted, that point in time cannot be restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの完全バックアップです。削除するとその時点の状態は復元できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整机备份。删除后该时间点的数据无法恢复。"
          }
        }
      }
    },
    "attr.notes.mail.attachments": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail attachments are personal data; deletion affects local copies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メール添付ファイルは個人データです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件附件属个人数据；删除影响本地副本。"
          }
        }
      }
    },
    "attr.notes.podcasts.downloads": {
      "extractionState": "stale",
      "localizations": {
        "en": {
