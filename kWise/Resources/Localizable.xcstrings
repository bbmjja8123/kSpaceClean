    "pw.buyout.pitch": {
      "extractionState": "manual",
      "comment": "P1 T7 — buyout paywall (non-consumable $9.90 / ¥68)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time purchase ¥68 ($9.90) · no subscription · scanning and attribution stay free · data never leaves your Mac"
