    "onboarding.page2.feature.attribution.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device rule attribution plus local semantic guesses — zero network, data never leaves the Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内ルールによる帰属＋オンデバイスの意味推測（ネットワーク不要、データは端末外に出ません）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
