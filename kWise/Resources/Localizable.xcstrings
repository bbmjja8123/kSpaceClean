        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切り ¥68（$9.90）· サブスクなし · スキャンと判定は永続無料 · データは端末から出ません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
