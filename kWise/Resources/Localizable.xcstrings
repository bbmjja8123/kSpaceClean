    "scanSpeed.turbo.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No CPU limit — fastest scan, may affect other apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 制限なし。最速ですが他のアプリに影響する場合があります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不限制 CPU，扫描最快，可能影响其他应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不限制 CPU，掃描最快，可能影響其他 App"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 제한 없음 — 가장 빠르지만 다른 앱에 영향을 줄 수 있습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne CPU-Begrenzung — schnellster Scan, kann andere Apps beeinträchtigen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune limite CPU — analyse la plus rapide, peut affecter d’autres applications"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin límite de CPU: el escaneo más rápido; puede afectar a otras aplicaciones"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem limite de CPU — varredura mais rápida, pode afetar outros apps"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun limite di CPU — scansione più veloce, può influire su altre app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ограничения ЦП — самое быстрое сканирование, может влиять на другие приложения"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا حد للمعالج — أسرع فحص، وقد يؤثر على التطبيقات الأخرى"
