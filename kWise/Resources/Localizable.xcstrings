          }
        }
      }
    },
    "photo.scan.none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No similar photos found — these directories are clean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发现相似的照片 — 这些目录很干净。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "類似する写真は見つかりませんでした — これらのフォルダはきれいです。"
          }
        }
      }
    },
    "photo.selection.keepOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one photo per group must stay — you can't delete them all."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每组至少保留一张照片，不能全部删除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループで少なくとも1枚の写真を残す必要があります。すべて削除することはできません。"
          }
        }
      }
    },
