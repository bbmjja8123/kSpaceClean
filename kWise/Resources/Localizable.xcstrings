    "startup.grant.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant access to your home folder to view and manage user-level startup items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权主目录后才能查看和管理用户级启动项。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームフォルダへのアクセスを許可すると、ユーザー単位の起動項目を表示・管理できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權主目錄後才能查看和管理使用者層級的啟動項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 수준 시작 항목을 보고 관리하려면 홈 폴더 권한을 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilen Sie Zugriff auf Ihren Benutzerordner, um Startobjekte auf Benutzerebene anzusehen und zu verwalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez l’accès à votre dossier personnel pour consulter et gérer les éléments d’ouverture au niveau utilisateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede acceso a la carpeta de inicio para ver y gestionar los elementos de inicio del usuario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acesso à sua pasta pessoal para ver e gerenciar itens de inicialização do usuário."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi l'accesso alla tua cartella home per vedere e gestire gli elementi di avvio a livello utente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставьте доступ к домашней папке, чтобы видеть объекты запуска пользователя и управлять ими."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح الوصول إلى مجلدك الرئيسي لعرض عناصر بدء التشغيل على مستوى المستخدم وإدارتها."
          }
        }
      }
    },
