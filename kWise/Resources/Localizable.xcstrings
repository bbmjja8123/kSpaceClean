    "warn.toast.headline.a11y": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ running apps are involved in the items you selected. Choose skip, force quit, or cancel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目には実行中のアプリが %@ 件関わっています。スキップ・強制終了・キャンセルから選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到 %@ 个运行中应用涉及您选择的清理项。请选择跳过、强制关闭或取消。"
          }
        }
      }
    },
    "warn.toast.row.a11y": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, PID %@, %@ conflicting paths, %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、PID %@、競合パス %@ 件、計 %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，PID %@，%@ 个冲突路径，共 %@"
