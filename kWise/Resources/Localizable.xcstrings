    "photo.selection.keepOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one photo per group must stay — you can't delete them all."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每组至少保留一张照片，不能全部删除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループで少なくとも1枚の写真を残す必要があります。すべて削除することはできません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每組至少保留一張照片，不能全部刪除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹마다 사진을 한 장 이상 남겨야 합니다 — 모두 삭제할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Gruppe muss mindestens ein Foto bleiben — Sie können nicht alle löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins une photo par groupe doit rester — impossible de toutes les supprimer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debe quedar al menos una foto por grupo: no se pueden borrar todas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos uma foto por grupo deve ficar — não é possível excluir todas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno una foto per gruppo deve restare — non puoi eliminarle tutte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В каждой группе должна остаться хотя бы одна фотография — удалить все нельзя."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تبقى صورة واحدة على الأقل في كل مجموعة — لا يمكنك حذفها كلها."
          }
        }
      }
