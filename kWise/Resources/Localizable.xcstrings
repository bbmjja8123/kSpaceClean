    "dupe.folder.backupTopicWithAge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These look like backup copies of \"%@\" — one hasn't changed in %lld days, like an older backup of the same project"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来是「%@」相关的备份副本——其中一个已经 %lld 天没有更新，像是同一项目的旧备份"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」関連のバックアップコピーのようです — 片方は %lld 日間更新されておらず、同じプロジェクトの古いバックアップのようです"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這看起來是「%@」相關的備份副本——其中一份已經 %lld 天沒有更新，像是同一專案的舊備份"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 관련 백업 사본으로 보입니다 — 하나는 %lld일 동안 갱신되지 않아 같은 프로젝트의 오래된 백업 같습니다"
          }
        },
        "de": {
