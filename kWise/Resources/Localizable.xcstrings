    "attr.refused.banner": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can't judge these safely, so they are excluded from suggestions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは安全に判定できないため、提案対象から除外しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
