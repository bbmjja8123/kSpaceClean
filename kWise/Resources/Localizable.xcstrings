    "uninstall.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps and leftovers move to the Trash and stay restorable for 30 days. Login sessions and personal data are never processed in the cloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用与残留移入废纸篓，30 天内可还原；登录态与个人数据不做云端处理"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリと残り物はゴミ箱へ移動し、30 日間は元に戻せます。ログイン状態と個人データをクラウドで処理することはありません。"
          }
        }
      }
