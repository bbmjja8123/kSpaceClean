    "assistant.answer.shredHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shredding overwrites the file contents first (one pass is enough on SSDs), then randomizes the names and moves them to the Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件粉碎先覆写内容（SSD 一次覆写已足够），再随机化文件名并移入废纸篓。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル粉砕はまず内容を上書きし（SSDでは1回で十分）、名前をランダム化してからゴミ箱へ移動します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "徹底粉碎會先覆寫檔案內容（SSD 上覆寫一次已足夠），再隨機化檔名並移入垃圾桶。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전 삭제는 먼저 파일 내용을 덮어쓴 후(SSD에서는 1회면 충분) 파일명을 무작위로 바꾸고 휴지통으로 이동합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim unwiderruflichen Löschen werden die Dateiinhalte zuerst überschrieben (ein Durchgang genügt auf SSDs), dann werden die Namen randomisiert und die Dateien in den Papierkorb verschoben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La destruction sécurisée écrase d’abord le contenu du fichier (un seul passage suffit sur SSD), puis randomise les noms et déplace les fichiers vers la Corbeille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La destrucción segura sobrescribe antes el contenido del archivo (una pasada basta en SSD), luego aleatoriza los nombres y los mueve a la Papelera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A destruição segura sobrescreve o conteúdo do arquivo primeiro (uma passada basta em SSDs), depois randomiza os nomes e os move para a Lixeira."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La distruzione sicura sovrascrive prima il contenuto del file (un passaggio basta sugli SSD), poi randomizza i nomi e li sposta nel Cestino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратное удаление сначала перезаписывает содержимое файла (на SSD достаточно одного прохода), затем случайным образом меняет имена и перемещает файлы в Корзину."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُكتب أولاً فوق محتويات الملف (تمريرة واحدة تكفي على أقراص SSD)، ثم تُغيَّر الأسماء عشوائيًا وتُنقل الملفات إلى المهملات."
          }
        }
      }
    },
