    "warn.toast.headline.a11y": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ running apps are involved in the items you selected. Choose skip, force quit, or cancel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目には実行中のアプリが %@ 件関わっています。スキップ・強制終了・キャンセルから選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到 %@ 个运行中应用涉及您选择的清理项。请选择跳过、强制关闭或取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到 %@ 個執行中的 App 涉及您選擇的清理項目。請選擇跳過、強制結束或取消。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 정리 항목에 실행 중인 앱 %@개가 연관되어 있습니다. 건너뛰기, 강제 종료 또는 취소를 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ laufende Apps betreffen die von Ihnen ausgewählten Elemente. Wählen Sie Überspringen, Sofort beenden oder Abbrechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ applications en cours d’exécution concernent les éléments que vous avez sélectionnés. Choisissez ignorer, forcer à quitter ou annuler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aplicaciones en ejecución están implicadas en los elementos seleccionados. Elige omitir, forzar el cierre o cancelar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ apps em execução estão envolvidos nos itens selecionados. Escolha pular, encerrar à força ou cancelar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ app in esecuzione coinvolte negli elementi selezionati. Scegli salta, forza chiusura o annulla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С выбранными элементами связаны работающие приложения: %@. Выберите: пропустить, завершить принудительно или отменить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ من التطبيقات قيد التشغيل تتعلق بالعناصر التي حددتها. اختر التخطي أو الإنهاء القسري أو الإلغاء."
          }
        }
      }
    },
