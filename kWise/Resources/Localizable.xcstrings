    "maintenance.task.userLogClear.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves user logs to the Trash to free disk space (restorable)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将用户日志移入废纸篓，释放磁盘空间（可回滚）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーログをゴミ箱へ移してディスクを空けます（復元可能）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將使用者日誌移入垃圾桶，釋放磁碟空間（可還原）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 로그를 휴지통으로 이동해 디스크 공간을 확보합니다(복원 가능)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt Benutzerprotokolle in den Papierkorb, um Speicherplatz freizugeben (wiederherstellbar)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace les journaux utilisateur à la Corbeille pour libérer de l’espace disque (restaurable)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve los registros del usuario a la Papelera para liberar espacio en disco (se pueden restaurar)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move os logs do usuário para a Lixeira para liberar espaço em disco (restaurável)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta i log utente nel Cestino per liberare spazio sul disco (ripristinabile)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещает журналы пользователя в Корзину, освобождая место на диске (восстановимо)"
