    "canvas.changes.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contents changed — rescan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容有变化——点按重新扫描"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が変わりました — 再スキャン"
          }
        }
      }
    },
    "kWise 会扫描系统缓存、应用缓存、日志与残留文件，扫描结果按应用归组展示。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise scans system caches, app caches, logs and leftover files, then groups the results by app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise はシステムキャッシュ、アプリキャッシュ、ログ、残留ファイルをスキャンし、アプリごとに結果をまとめて表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise 会扫描系统缓存、应用缓存、日志与残留文件，扫描结果按应用归组展示。"
          }
        }
      }
    },
    "kWise 只列出它能实际处理的项目；其余项会直接带你去系统设置。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise only lists items it can actually handle; the rest take you straight to System Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise は実際に処理できる項目のみを表示します。それ以外はシステム設定へご案内します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise 只列出它能实际处理的项目；其余项会直接带你去系统设置。"
          }
        }
      }
    },
    "kWise 可以扫描家目录下的缓存、日志与应用残留。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise can scan your home folder for caches, logs and app leftovers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise はホームフォルダ内のキャッシュ、ログ、アプリの残留ファイルをスキャンできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise 可以扫描家目录下的缓存、日志与应用残留。"
          }
        }
      }
    },
    "kWise 在沙箱内运行，需要你一次性授权主目录才能扫描缓存、日志与应用残留。文件不会被上传，扫描全部在本机完成。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise runs in a sandbox and needs a one-time grant for your home folder to scan caches, logs and app leftovers. Nothing is uploaded — scanning happens entirely on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise はサンドボックス内で動作するため、キャッシュ・ログ・アプリの残留ファイルをスキャンするにはホームフォルダへの一回限りの許可が必要です。ファイルがアップロードされることはなく、スキャンはすべて本機で完結します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "kWise 在沙箱内运行，需要你一次性授权主目录才能扫描缓存、日志与应用残留。文件不会被上传，扫描全部在本机完成。"
          }
        }
      }
    },
