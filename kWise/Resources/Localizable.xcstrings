    "settings.privacy.grantRequired.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant access to scan browser history, cookies and download records."
          }
        },
        "ja": {
          "stringUnit": {
