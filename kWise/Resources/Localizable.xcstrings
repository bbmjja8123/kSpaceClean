            "value": "The granted access doesn't cover the Screenshots folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前授权范围无法读取截图目录"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のアクセス許可ではスクリーンショットフォルダを読み取れません"
          }
        }
      }
    },
    "photo.screenshots.none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No old screenshots from the last 30 days to clean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近 30 天没有需要清理的旧截图。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近30日間にクリーンアップすべき古いスクリーンショットはありません。"
          }
        }
      }
    },
    "photo.screenshots.preselected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots older than 30 days are preselected, keeping the newest in each group. Review and clean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已预选 30 天前的旧截图，每组保留最新一张。请确认后清理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日より古いスクリーンショットを選択済みにしました（各グループで最新の1枚を保持）。確認してクリーンアップしてください。"
          }
        }
      }
    },
    "photo.scan.noAccess": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The granted access doesn't cover the photo folders"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前授权范围无法读取照片目录"
          }
