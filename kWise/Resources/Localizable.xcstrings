    "canvas.plusMenu.a11y.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens tools: uninstall, startup items, shredder and attribution rules"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开工具：应用卸载、启动项、粉碎与归因规则"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールを開く：アプリ削除、起動項目、シュレッダー、帰属ルール"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟工具：App 解除安裝、啟動項目、徹底粉碎與歸因規則"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 열기: 앱 제거, 시작 항목, 완전 삭제, 원인 분석 규칙"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Werkzeuge: Deinstallieren, Startobjekte, unwiderrufliches Löschen und Ursachenanalyse-Regeln"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les outils : désinstallation, éléments d’ouverture, destruction sécurisée et règles d’analyse des causes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre herramientas: desinstalar, elementos de inicio, destrucción segura y reglas de análisis de causas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre ferramentas: desinstalação, itens de inicialização, destruição segura e regras de análise de causas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre gli strumenti: disinstallazione, elementi di avvio, distruzione sicura e regole di analisi delle cause"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает инструменты: удаление приложений, элементы запуска, безвозвратное удаление и правила определения причин"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الأدوات: إزالة التطبيقات، عناصر بدء التشغيل، التدمير الآمن وقواعد تحليل الأسباب"
          }
        }
      }
    },
