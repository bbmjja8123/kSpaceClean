    "uninstall.detail.groupingDegraded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Semantic grouping unavailable (on-device model missing); grouped by path rules instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语义分组降级（本机语义模型不可用），按路径规则分组。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意味ベースのグループ化を利用できないため（端末内モデルなし）、パスのルールでグループ分けしています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語義分組降級（本機語義模型不可用），改按路徑規則分組。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의미 기반 그룹화를 사용할 수 없어(기기 내 모델 없음) 경로 규칙으로 그룹화했습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Semantische Gruppierung nicht verfügbar (lokales Modell fehlt); stattdessen nach Pfadregeln gruppiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupement sémantique indisponible (modèle local absent) ; regroupement par règles de chemins à la place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupación semántica no disponible (falta el modelo en el dispositivo); agrupado por reglas de ruta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupamento semântico indisponível (modelo no dispositivo ausente); agrupado por regras de caminho em vez disso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppamento semantico non disponibile (modello locale mancante); raggruppate per regole di percorso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семантическая группировка недоступна (нет локальной модели); сгруппировано по правилам путей."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التجميع الدلالي غير متاح (ينقص النموذج على الجهاز)؛ جُمّعت حسب قواعد المسارات بدلًا من ذلك."
          }
        }
      }
    },
