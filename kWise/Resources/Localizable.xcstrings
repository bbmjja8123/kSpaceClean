    "assistant.answer.cleanupNow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the safe quick-clean button on the anatomy canvas to scan and clean recommended items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击首屏的「安全快捷回收」按钮，即可扫描并清理推荐项。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスの「安全なクイッククリーン」ボタンをタップすると、推奨項目をスキャンして整理します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按首屏畫布的「安全快速清理」按鈕，即可掃描並清理建議項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 화면 캔버스의 \"안전한 빠른 정리\" 버튼을 누르면 스캔 후 권장 항목을 정리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die Schaltfläche für die sichere Schnellbereinigung in der Übersicht, um empfohlene Elemente zu scannen und zu bereinigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton de nettoyage rapide sécurisé sur la vue d’ensemble pour analyser et nettoyer les éléments recommandés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de limpieza rápida segura del panel para escanear y limpiar los elementos recomendados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de limpeza rápida segura no painel de anatomia para varrer e limpar os itens recomendados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante di pulizia rapida sicura nel panorama per scansionare e pulire gli elementi consigliati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку «Безопасная быстрая очистка» на холсте первого экрана, чтобы просканировать и очистить рекомендованные элементы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر زر التنظيف السريع الآمن على اللوحة التشريحية لفحص العناصر الموصى بها وتنظيفها."
          }
        }
      }
    },
    "assistant.answer.similarPhotos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar photos appear grouped on the anatomy canvas: on-device perceptual matching finds screenshot piles, keeping at least one per group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相似照片按组呈现在首屏画布上：本机感知比对找出截图堆积，每组至少保留一张。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "類似写真はキャンバスにグループで表示されます。端末内の知覚マッチングでスクリーンショットの山を見つけ、各グループで必ず1枚を残します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相似照片會以群組呈現首屏畫布：本機感知比對找出截圖堆積，每組至少保留一張。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유사한 사진은 첫 화면 캔버스에 그룹으로 표시됩니다. 기기 내 지각 기반 비교로 스크린샷 묶음을 찾아 그룹마다 한 장 이상 남깁니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnliche Fotos erscheinen gruppiert in der Übersicht: Das lokale Wahrnehmungs-Abgleichen findet angesammelte Screenshots und behält mindestens ein Foto pro Gruppe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos similaires apparaissent regroupées sur la vue d’ensemble : la comparaison perceptuelle effectuée sur l’appareil repère les accumulations de captures d’écran, en gardant au moins une photo par groupe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos similares aparecen agrupadas en el panel: la coincidencia perceptual en el dispositivo encuentra acumulaciones de capturas y conserva al menos una por grupo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos semelhantes aparecem agrupadas no painel de anatomia: a correspondência perceptual no dispositivo encontra acúmulos de capturas de tela, mantendo pelo menos uma por grupo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto simili compaiono raggruppate nel panorama: il confronto percettivo locale trova gli accumuli di screenshot, conservando almeno una foto per gruppo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похожие фото показаны группами на холсте первого экрана: локальное перцептивное сравнение находит нагромождения скриншотов, в каждой группе остаётся минимум одно фото."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الصور المتشابهة مجمّعة على اللوحة التشريحية: تجد المطابقة الإدراكية على الجهاز أكوام لقطات الشاشة، مع الاحتفاظ بصورة واحدة على الأقل في كل مجموعة."
          }
        }
      }
    },
