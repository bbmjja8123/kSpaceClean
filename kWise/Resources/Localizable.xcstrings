    "intent.askstatus.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report disk usage and cleanup forecast."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汇报磁盘占用与清理预测。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク使用量と整理の予測を報告します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回報磁碟佔用與清理預測。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 사용량과 정리 예측을 보고합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichernutzung und Bereinigungsprognose melden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique l’occupation du disque et la prévision de nettoyage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa del uso del disco y de la previsión de limpieza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa o uso do disco e a previsão de limpeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta l'uso del disco e la previsione di pulizia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает о заполнении диска и прогнозе очистки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض استخدام القرص وتنبؤ التنظيف."
