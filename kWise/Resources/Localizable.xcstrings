    "onboarding.grant.directBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This edition runs directly on your Mac and can read the full disk for scanning. Nothing is uploaded — scanning happens entirely on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエディションは Mac 上で直接動作し、ディスク全体を読み取ってスキャンできます。ファイルのアップロードは行われず、スキャンはすべて本機で完結します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本直接运行于你的 Mac 上，可读取完整磁盘完成扫描。文件不会被上传，扫描全部在本机完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本直接在你的 Mac 上執行，可讀取完整磁碟完成掃描。檔案不會被上傳，掃描全部在本機完成。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전은 Mac에서 직접 실행되며 전체 디스크를 읽어 스캔할 수 있습니다. 파일은 업로드되지 않으며 스캔은 전부 이 Mac에서 이루어집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Edition läuft direkt auf Ihrem Mac und kann zum Scannen die gesamte Festplatte lesen. Nichts wird hochgeladen — das Scannen geschieht vollständig auf diesem Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette édition s’exécute directement sur votre Mac et peut lire l’ensemble du disque pour l’analyse. Rien n’est envoyé — l’analyse se déroule entièrement sur ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta edición se ejecuta directamente en el Mac y puede leer todo el disco para escanear. No se sube nada: el escaneo se realiza íntegramente en este Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta edição roda diretamente no seu Mac e pode ler o disco completo para a varredura. Nada é enviado — a varredura acontece inteiramente neste Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa edizione gira direttamente sul tuo Mac e può leggere l'intero disco per la scansione. Nessun dato viene caricato — la scansione avviene interamente su questo Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия запускается прямо на вашем Mac и может читать весь диск для сканирования. Файлы никуда не загружаются — сканирование полностью выполняется на этом Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل هذا الإصدار مباشرة على جهاز Mac لديك ويمكنه قراءة القرص كاملًا للفحص. لا يُرفع أي شيء — الفحص يجري كليًا على هذا الـ Mac."
          }
        }
      }
    },
