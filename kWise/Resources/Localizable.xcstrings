    "assistant.answer.duplicates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate files appear grouped on the anatomy canvas — tap a group card to drill down and pick items. After a scan the newest original is kept automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复文件按组呈现在首屏画布上，点组卡进下钻页逐项勾选；扫描后会智能保留最新原件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複ファイルはグループごとにキャンバスに表示されます。グループカードから下位画面で1件ずつ選べます。スキャン後は最新の原本を自動的に残します。"
          }
        }
      }
    },
