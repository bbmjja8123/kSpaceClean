        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The storage controller self-test failed. Back up important data now and contact Apple Support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储控制器自检失败。建议立即备份重要数据并联系 Apple 支持。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
