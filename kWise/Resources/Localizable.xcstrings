    "photo.screenshots.preselected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots older than 30 days are preselected, keeping the newest in each group. Review and clean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已预选 30 天前的旧截图，每组保留最新一张。请确认后清理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日より古いスクリーンショットを選択済みにしました（各グループで最新の1枚を保持）。確認してクリーンアップしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已預先勾選 30 天前的舊截圖，每組保留最新一張。請確認後清理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일이 지난 스크린샷을 미리 선택하고 그룹마다 가장 최근 것을 남겼습니다. 확인 후 정리하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots älter als 30 Tage sind vorausgewählt, das neueste pro Gruppe bleibt erhalten. Prüfen und bereinigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d’écran de plus de 30 jours sont présélectionnées, en gardant la plus récente de chaque groupe. Vérifiez puis nettoyez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de más de 30 días vienen preseleccionadas, conservando la más reciente de cada grupo. Revísalas y limpia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturas de tela com mais de 30 dias vêm pré-selecionadas, mantendo a mais recente de cada grupo. Revise e limpe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le istantanee più vecchie di 30 giorni sono preselezionate, conservando la più recente di ogni gruppo. Rivedi e pulisci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительно выбраны снимки экрана старше 30 дней; в каждой группе оставлено самое новое. Проверьте и очистите."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقطات الشاشة الأقدم من 30 يومًا محددة مسبقًا، مع الاحتفاظ بالأحدث في كل مجموعة. راجع ونظّف."
          }
        }
      }
    },
