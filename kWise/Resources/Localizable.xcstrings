    "canvas.guidance.migrate.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move these files to an external disk or a cloud drive — they are not junk, and the space frees up on this Mac once moved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这些文件迁到外置磁盘或云盘 —— 它们不是垃圾，迁出后本机空间即被释放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイルはゴミではありません。外付けディスクやクラウドに移すと、この Mac の空き領域が増えます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將這些檔案遷移到外接磁碟或雲端硬碟——它們不是垃圾，遷出後本機空間隨即釋放。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일들을 외장 디스크나 클라우드 드라이브로 옮기세요. 정크가 아니며, 옮기면 이 Mac의 공간이 확보됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben Sie diese Dateien auf eine externe Festplatte oder in einen Cloud-Speicher — sie sind kein Müll, und der Platz auf diesem Mac wird frei, sobald sie verschoben sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez ces fichiers vers un disque externe ou un service cloud — ce ne sont pas des déchets, et l’espace se libère sur ce Mac une fois déplacés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve estos archivos a un disco externo o a una unidad en la nube: no son basura, y el espacio se libera en este Mac una vez movidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova estes arquivos para um disco externo ou uma unidade na nuvem — eles não são lixo, e o espaço é liberado neste Mac assim que movidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta questi file su un disco esterno o su un'unità cloud — non sono spazzatura, e lo spazio si libera su questo Mac una volta spostati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместите эти файлы на внешний диск или в облачное хранилище — это не мусор, и место на этом Mac освободится после переноса."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقل هذه الملفات إلى قرص خارجي أو قرص سحابي — فهي ليست ملفات غير مرغوبة، وتتحرر المساحة على هذا الـ Mac بمجرد نقلها."
          }
        }
      }
    },
    "canvas.guidance.migrate.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files are not junk — moving them out is the safe way to free the space:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件不是垃圾 —— 迁出才是释放空间的正确方式："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイルはゴミではありません — 移し替えるのが安全な解放方法です："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些檔案不是垃圾——遷出才是釋放空間的正確方式："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일들은 정크가 아닙니다. 안전하게 공간을 확보하려면 옮기는 것이 좋습니다:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dateien sind kein Müll — das Auslagern ist der sichere Weg, den Platz freizugeben:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fichiers ne sont pas des déchets — les déplacer est la façon sûre de libérer l’espace :"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos archivos no son basura; moverlos fuera es la forma segura de liberar ese espacio:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes arquivos não são lixo — movê-los para fora é o jeito seguro de liberar o espaço:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi file non sono spazzatura — spostarli fuori è il modo sicuro per liberare lo spazio:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти файлы — не мусор. Безопасный способ освободить место — переместить их:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الملفات ليست غير مرغوبة — نقلها إلى الخارج هو الطريقة الآمنة لتحرير المساحة:"
          }
        }
      }
    },
    "canvas.guidance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
