    "paywall.direct.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The direct edition has no in-app purchase. Open the Mac App Store, search for Klaris, and unlock reclamation actions with a one-time purchase; scanning, attribution and the refusal list stay free forever in every edition."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直営版にはアプリ内課金がありません。Mac App Store で Klaris を検索して、買い切りで回収アクションを解放できます。スキャン・帰属・拒否リストはすべてのエディションで永久無料です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直营版不提供内购。打开 Mac App Store 搜索 Klaris，一次买断解锁回收动作；扫描、归因与拒答清单在所有版本永久免费。"
          }
        }
      }
    },
    "paywall.direct.title": {
