    "history.forecast.filling": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the current trend, the disk will be full in about %lld days. Consider clearing large files ahead of time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当前趋势，预计约 %lld 天后磁盘占满。建议提前清理大文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の傾向では、約%lld日後にディスクが満杯になる見込みです。大きなファイルを先に整理しておきましょう。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依目前趨勢，預計約 %lld 天後磁碟佔滿。建議提前清理大型檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 추세라면 약 %lld일 후에 디스크가 가득 찹니다. 미리 대용량 파일을 정리하는 것이 좋습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim aktuellen Trend ist die Festplatte in etwa %lld Tagen voll. Räumen Sie große Dateien besser frühzeitig auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au rythme actuel, le disque sera plein dans environ %lld jours. Pensez à nettoyer les gros fichiers à l’avance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la tendencia actual, el disco se llenará en unos %lld días. Plantéate borrar antes los archivos grandes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tendência atual, o disco ficará cheio em cerca de %lld dias. Considere limpar arquivos grandes com antecedência."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l'andamento attuale il disco si riempirà in circa %lld giorni. Valuta di svuotare in anticipo i file di grandi dimensioni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При текущей тенденции диск заполнится примерно через %lld дней. Стоит заранее освободить место от больших файлов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالوتيرة الحالية سيمتلئ القرص خلال نحو %lld يومًا. يُنصح بتنظيف الملفات الكبيرة مسبقًا."
          }
        }
      }
    },
