    "onboarding.page2.feature.attribution.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device rule attribution plus local semantic guesses — zero network, data never leaves the Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内ルールによる帰属＋オンデバイスの意味推測（ネットワーク不要、データは端末外に出ません）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机规则归因 + 端上语义推测（零网络，数据不出机）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機規則歸因 + 裝置端語義推測（零網路，資料不出機）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 규칙 기반 원인 분석 + 로컬 의미 추정 — 네트워크 사용 없음, 데이터는 Mac 밖으로 나가지 않음"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Ursachenanalyse per Regel plus lokale semantische Vermutungen — kein Netzwerk, Daten verlassen den Mac nie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse des causes par règles sur l’appareil plus suppositions sémantiques locales — zéro réseau, les données ne quittent jamais le Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis de causas por reglas en el dispositivo más conjeturas semánticas locales: cero red, los datos nunca salen del Mac"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Análise de causas por regras no dispositivo mais suposições semânticas locais — zero rede, os dados nunca saem do Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisi delle cause basata su regole in locale più ipotesi semantiche locali — zero rete, i dati non lasciano mai il Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальное определение причин по правилам плюс локальные семантические догадки — без сети, данные не покидают Mac"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحليل أسباب بالقواعد على الجهاز مع تخمينات دلالية محلية — صفر شبكة، والبيانات لا تغادر الـ Mac أبدًا"
          }
        }
      }
    },
