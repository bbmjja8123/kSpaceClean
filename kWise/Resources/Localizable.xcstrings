    "attr.notes.ai.models-intelligence": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System-managed AI models. Downloads and enablement are controlled in System Settings; this app will not — and cannot — delete them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム管理の AI モデルです。ダウンロードと有効化はシステム設定で管理され、本アプリは削除できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统管理的 AI 模型，下载与启用由系统设置控制；本应用不会也无法删除它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由系統管理的 AI 模型，下載與啟用都在系統設定中控制；本 App 不會也無法刪除它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 관리하는 AI 모델입니다. 다운로드와 사용 설정은 시스템 설정에서 제어하며, 이 앱은 삭제할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom System verwaltete KI-Modelle. Downloads und Aktivierung werden in den Systemeinstellungen gesteuert; diese App wird sie nicht — und kann sie nicht — löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèles d’IA gérés par le système. Le téléchargement et l’activation se règlent dans Réglages Système ; cette application ne peut pas les supprimer — et ne le fera pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos de IA gestionados por el sistema. Su descarga y activación se controlan en Ajustes del Sistema; esta aplicación no puede eliminarlos y no lo hará."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos de IA gerenciados pelo sistema. Downloads e ativação são controlados nos Ajustes do Sistema; este app não vai — e não pode — excluí-los."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelli AI gestiti dal sistema. Download e attivazione si controllano in Impostazioni di Sistema; questa app non li elimina — e non può farlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели AI управляются системой. Загрузка и включение настраиваются в Системных настройках; это приложение не может и не будет их удалять."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نماذج ذكاء اصطناعي يديرها النظام. يتم التنزيل والتمكين من إعدادات النظام؛ هذا التطبيق لن يحذفها — ولا يمكنه ذلك."
          }
        }
      }
    },
    "attr.notes.caches.app-generic": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App caches — the classic 'deletes itself back': usually rebuilt within days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのキャッシュ。「削除すると戻ってくる」代表例です。通常は数日で再生成されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用缓存。这是「删了又回来」的典型：通常数天内按需重建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 快取。這是「刪了又會回來」的典型：通常數天內就會按需求重建。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 캐시 — \"지우면 다시 생기는\" 전형적인 항목입니다. 보통 며칠 안에 필요할 때 다시 만들어집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Caches — der Klassiker, der sich selbst neu anlegt: meist innerhalb weniger Tage wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches d’applications — le cas classique du « ça revient tout seul » : généralement reconstruits en quelques jours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés de aplicaciones, el clásico «se vuelve a crear solo»: normalmente se reconstruyen en cuestión de días."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches de apps — o clássico \"se recria sozinho\": geralmente são refeitos em poucos dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache delle app — il classico caso che “si ricrea da sola”: di solito viene ricostruita entro pochi giorni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэш приложений — классический случай «удалишь, а он вернётся»: обычно восстанавливается за считанные дни."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرات التطبيقات المؤقتة — «المعاد توليدها تلقائيًا» الكلاسيكية: تُعاد بناؤها عادة خلال أيام."
          }
        }
      }
    },
    "attr.notes.dingtalk.files": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work and chat data are personal data; no deletion advice is given."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "業務・チャットデータは個人データです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "办公与聊天数据属个人数据；本应用不给删除建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "辦公與聊天資料屬個人資料；本 App 不提供刪除建議。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업무·채팅 데이터는 개인 데이터입니다. 삭제 권고를 하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeits- und Chat-Daten sind persönliche Daten; es gibt keinen Löschhinweis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données professionnelles et de messagerie sont des données personnelles ; aucun conseil de suppression n’est donné."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de trabajo y de chat son datos personales; no se ofrece consejo de eliminación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados de trabalho e de chat são dados pessoais; nenhuma recomendação de exclusão é dada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di lavoro e di chat sono dati personali; non viene fornito alcun consiglio di eliminazione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочие и чат-данные — это личные данные; советы по удалению не даются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات العمل والدردشة بيانات شخصية؛ لا نقدّم نصيحة بالحذف."
          }
        }
      }
    },
    "attr.notes.docker.disk-image": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker's VM disk: deleting it removes every image and container. This is data deletion, not junk cleanup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker の仮想ディスクです。削除すると全イメージとコンテナが失われます。これはデータ削除であり、ゴミ掃除ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 虚拟磁盘：删除会连带删除全部镜像与容器。这是数据删除，不是垃圾清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 虛擬磁碟：刪除會一併移除全部映像檔與容器。這是資料刪除，不是垃圾清理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 가상 디스크입니다. 삭제하면 모든 이미지와 컨테이너가 함께 삭제됩니다. 정크 정리가 아니라 데이터 삭제입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die VM-Festplatte von Docker: Wird sie gelöscht, gehen alle Images und Container verloren. Das ist eine Datenlöschung, keine Müllbereinigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disque virtuel de Docker : le supprimer efface toutes les images et tous les conteneurs. C’est une suppression de données, pas un nettoyage de déchets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disco virtual de Docker: al eliminarlo se borran todas las imágenes y contenedores. Es una eliminación de datos, no una limpieza de basura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco de VM do Docker: excluí-lo remove todas as imagens e containers. Isto é exclusão de dados, não limpeza de lixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco della macchina virtuale di Docker: eliminarlo rimuove tutte le immagini e i container. È un'eliminazione di dati, non una pulizia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск виртуальной машины Docker: удаление уничтожит все образы и контейнеры. Это удаление данных, а не очистка мусора."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرص الآلة الافتراضية لـ Docker: حذفه يزيل كل الصور والحاويات. هذا حذف بيانات، لا تنظيف ملفات غير مرغوبة."
          }
        }
      }
    },
