    "uninstall.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps and leftovers move to the Trash and stay restorable for 30 days. Login sessions and personal data are never processed in the cloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用与残留移入废纸篓，30 天内可还原；登录态与个人数据不做云端处理"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリと残り物はゴミ箱へ移動し、30 日間は元に戻せます。ログイン状態と個人データをクラウドで処理することはありません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 與殘留移入垃圾桶，30 天內可還原；登入狀態與個人資料不做雲端處理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱과 잔여 파일은 휴지통으로 이동되며 30일간 복원할 수 있습니다. 로그인 상태와 개인 데이터는 클라우드에서 처리하지 않습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps und Restdateien wandern in den Papierkorb und bleiben 30 Tage lang wiederherstellbar. Anmeldesitzungen und persönliche Daten werden niemals in der Cloud verarbeitet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les applications et leurs restants vont à la Corbeille et restent restaurables pendant 30 jours. Les sessions connectées et les données personnelles ne sont jamais traitées dans le cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aplicaciones y sus residuos se mueven a la Papelera y siguen siendo restaurables durante 30 días. Las sesiones iniciadas y los datos personales nunca se procesan en la nube."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps e resíduos vão para a Lixeira e permanecem restauráveis por 30 dias. Sessões de login e dados pessoais nunca são processados na nuvem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App e residui vengono spostati nel Cestino e restano ripristinabili per 30 giorni. Le sessioni di login e i dati personali non vengono mai elaborati nel cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения и остаточные файлы перемещаются в Корзину и остаются восстановимыми 30 дней. Сеансы входа и личные данные в облаке не обрабатываются"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتقل التطبيقات وبقاياها إلى المهملات وتبقى قابلة للاستعادة لمدة 30 يومًا. جلسات تسجيل الدخول والبيانات الشخصية لا تُعالج في السحابة أبدًا."
          }
        }
      }
    },
