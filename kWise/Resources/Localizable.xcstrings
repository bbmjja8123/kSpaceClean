    "uninstall.confirm.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items (about %@) will move to the Trash and stay restorable for 30 days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 项（约 %@）将移入废纸篓，30 天内可还原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項目（約 %@）をゴミ箱に移動します。30 日間は元に戻せます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 項（約 %@）將移入垃圾桶，30 天內可還原。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목(약 %@)이 휴지통으로 이동되며 30일간 복원할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Elemente (etwa %@) wandern in den Papierkorb und bleiben 30 Tage lang wiederherstellbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments (environ %@) seront déplacés à la Corbeille et resteront restaurables pendant 30 jours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elementos (unos %@) se moverán a la Papelera y seguirán siendo restaurables durante 30 días."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld itens (cerca de %@) serão movidos para a Lixeira e permanecerão restauráveis por 30 dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elementi (circa %@) verranno spostati nel Cestino e resteranno ripristinabili per 30 giorni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементов: %lld (около %@) — будут перемещены в Корзину и останутся восстановимыми 30 дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينتقل %lld من العناصر (نحو %@) إلى المهملات وتبقى قابلة للاستعادة لمدة 30 يومًا."
