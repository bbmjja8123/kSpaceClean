    "startup.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User-level items can be disabled and restored anytime; system-level items come with manual guidance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户级启动项可停用并随时恢复；系统级项目给出手动处理指引"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー単位の起動項目は無効化していつでも復元でき、システム単位の項目には手動での対処方法を案内します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者層級啟動項目可停用並隨時還原；系統層級項目提供手動處理指引"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 수준 항목은 비활성화 후 언제든 복원할 수 있으며, 시스템 수준 항목은 수동 처리 안내를 제공합니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte auf Benutzerebene lassen sich jederzeit deaktivieren und wiederherstellen; Objekte auf Systemebene kommen mit manueller Anleitung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments au niveau utilisateur peuvent être désactivés et restaurés à tout moment ; les éléments système s’accompagnent d’un guide manuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos del usuario se pueden desactivar y restaurar en cualquier momento; los del sistema incluyen guía manual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens do usuário podem ser desativados e restaurados a qualquer momento; itens do sistema vêm com orientação manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi a livello utente possono essere disattivati e ripristinati in qualsiasi momento; quelli a livello di sistema prevedono una guida manuale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты пользователя можно отключать и восстанавливать в любой момент; для системных предусмотрены ручные инструкции"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تعطيل العناصر على مستوى المستخدم واستعادتها في أي وقت؛ والعناصر على مستوى النظام تأتي مع إرشادات يدوية."
          }
        }
      }
    },
