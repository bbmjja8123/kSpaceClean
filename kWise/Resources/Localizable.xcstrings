            "value": "لا توفر وحدة التحكم هذه بيانات S.M.A.R.T."
          }
        }
      }
    },
    "diskhealth.smart.subtitle.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No S.M.A.R.T. data was read. Common on Apple Silicon; grant Full Disk Access for more detail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未读取到 S.M.A.R.T. 数据。在 Apple Silicon 上常见；可授予完整磁盘访问以获取更详细信息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. データを読み取れませんでした。Apple Silicon ではよくあることです。詳細にはフルディスクアクセスの許可が必要です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未讀取到 S.M.A.R.T. 資料。在 Apple Silicon 上很常見；可授予完整磁碟存取以取得更詳細資訊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. 데이터를 읽지 못했습니다. Apple Silicon에서 흔한 현상이며, 전체 디스크 접근 권한을 허용하면 더 자세히 볼 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine S.M.A.R.T.-Daten gelesen. Auf Apple Silicon häufig; erteilen Sie Vollzugriff auf die Festplatte für mehr Details."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée S.M.A.R.T. lue. Fréquent sur Apple Silicon ; accordez l’accès complet au disque pour plus de détails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se leyeron datos S.M.A.R.T. Es habitual en Apple Silicon; concede el Acceso total al disco para más detalle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dado do S.M.A.R.T. foi lido. Comum no Apple Silicon; conceda o Acesso Total ao Disco para mais detalhes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dato S.M.A.R.T. letto. Comune su Apple Silicon; concedi l'Accesso completo al disco per maggiori dettagli."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные S.M.A.R.T. не получены. На Apple Silicon это обычное явление; для подробностей предоставьте полный доступ к диску."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُقرأ بيانات S.M.A.R.T. وهذا شائع على Apple Silicon؛ امنح الوصول الكامل إلى القرص لمزيد من التفاصيل."
          }
        }
      }
    },
