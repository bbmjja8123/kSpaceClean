    "canvas.quickclean.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was recommended this time. The groups on the canvas below can still be reviewed and cleaned individually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次没有推荐清理的项目。下方画布里的分组仍可逐组预演清理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回は推奨項目がありません。下のキャンバスのグループは個別に確認してクリーンできます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次沒有建議清理的項目。下方畫布裡的群組仍可逐一預演清理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번에는 추천 항목이 없습니다. 아래 캔버스의 그룹은 언제든 개별적으로 검토하고 정리할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesmal gab es keine Empfehlungen. Die Gruppen in der Übersicht unten können weiterhin einzeln geprüft und bereinigt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été recommandé cette fois. Les groupes de la vue d’ensemble ci-dessous restent vérifiables et nettoyables un par un."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vez no se recomendó nada. Los grupos del panel de abajo se pueden revisar y limpiar uno por uno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi recomendado desta vez. Os grupos no painel abaixo ainda podem ser revisados e limpos individualmente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elemento consigliato questa volta. I gruppi nel panorama qui sotto possono comunque essere esaminati e puliti singolarmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот раз рекомендаций нет. Группы на холсте ниже всё ещё можно просмотреть и очистить по отдельности."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء موصى به هذه المرة. لا يزال بإمكانك مراجعة المجموعات على اللوحة أدناه وتنظيفها فرديًا."
          }
        }
      }
    },
    "canvas.ring.a11y.hint": {
