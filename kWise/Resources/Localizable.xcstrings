    "uninstall.warning.sharedDirectory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld leftovers are in a directory shared with other apps (%@…); deleting them may affect those apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个残留位于与其他应用共享的目录（%@…），删除可能影响其他应用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の残り物が他のアプリと共有するフォルダ（%@…）にあります。削除すると他のアプリに影響する可能性があります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個殘留位於與其他 App 共用的目錄（%@…），刪除可能影響其他 App。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔여 파일 %lld개가 다른 앱과 공유하는 디렉터리(%@…)에 있습니다. 삭제하면 해당 앱에 영향을 줄 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Restdateien liegen in einem mit anderen Apps geteilten Verzeichnis (%@ …); das Löschen kann diese Apps beeinträchtigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld restants se trouvent dans un dossier partagé avec d’autres applications (%@…) ; les supprimer pourrait affecter ces applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld residuos están en un directorio compartido con otras aplicaciones (%@…); borrarlos puede afectar a esas aplicaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld resíduos estão em um diretório compartilhado com outros apps (%@…); excluí-los pode afetar esses apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld residui si trovano in una directory condivisa con altre app (%@…); eliminarli può influire su quelle app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаточных файлов в папке, общей с другими приложениями, — %lld (%@…); их удаление может затронуть эти приложения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld من البقايا في مجلد مشترك مع تطبيقات أخرى (%@…)؛ حذفها قد يؤثر على تلك التطبيقات."
          }
        }
      }
    },
