    "assistant.answer.startupItems": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-item startup item control will return in a later release; this version does not change any startup items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动项的逐项停用与恢复将在后续版本回归；本版本不会改动任何启动项。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目の個別停止・復元は今後のバージョンで復活予定です。このバージョンではログイン項目を変更しません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動項目的逐項停用與還原將在後續版本回歸；本版本不會更動任何啟動項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 항목의 항목별 제어는 이후 버전에서 다시 제공됩니다. 이 버전은 시작 항목을 변경하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steuerung einzelner Startobjekte folgt in einer späteren Version; diese Version ändert keine Startobjekte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La gestion individuelle des éléments d’ouverture reviendra dans une version ultérieure ; cette version ne modifie aucun élément d’ouverture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El control individual de elementos de inicio volverá en una versión posterior; esta versión no cambia ningún elemento de inicio."
          }
        },
        "pt-BR": {
          "stringUnit": {
