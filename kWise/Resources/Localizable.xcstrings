    "attr.safeclean.subtitle": {
      "extractionState": "stale",
      "comment": "P1 T6 — honest scope line on the safe-quick-clean page",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only auto-rebuildable caches — restorable from History for 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動再生成されるキャッシュのみ。30 日間は履歴から復元できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只处理可自动重建的缓存类项目，30 天内可从历史还原。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只處理可自動重建的快取類項目，30 天內可從歷史記錄還原。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 다시 생성되는 캐시류만 처리하며, 30일 이내 기록에서 복원할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur automatisch neu erstellbare Caches — innerhalb von 30 Tagen über den Verlauf wiederherstellbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement des caches reconstruits automatiquement — restaurables depuis l’historique pendant 30 jours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cachés que el sistema reconstruye solo; se pueden restaurar desde Historial durante 30 días."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas caches que se reconstroem sozinhos — restauráveis pelo Histórico por 30 dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cache che si rigenerano automaticamente — ripristinabili dalla Cronologia per 30 giorni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только кэши, которые восстанавливаются автоматически, — восстановимо из «Истории» в течение 30 дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرات مؤقتة قابلة لإعادة البناء تلقائيًا فقط — قابلة للاستعادة من السجل لمدة 30 يومًا."
          }
        }
      }
    },
