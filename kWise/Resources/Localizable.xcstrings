    "将 %@ 个应用及其残留文件移入废纸篓，可回收 %@ 空间。残留会先备份 30 天，可从备份还原。%@%@": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "将 %1$@ 个应用及其残留文件移入废纸篓，可回收 %2$@ 空间。残留会先备份 30 天，可从备份还原。%3$@%4$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個のアプリとその残留ファイルをゴミ箱へ移動し、%@ の容量を再利用できます。残留は 30 日間バックアップされ、バックアップから復元できます。%@%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 个应用及其残留文件移入废纸篓，可回收 %@ 空间。残留会先备份 30 天，可从备份还原。%@%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 %1$@ 個 App 及其殘留檔案移入垃圾桶，約可回收 %2$@ 空間。殘留會先備份 30 天，可從備份還原。%3$@%4$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 %1$@개와 잔여 파일을 휴지통으로 이동하면 %2$@ 공간을 회수할 수 있습니다. 잔여 파일은 30일간 백업되며 백업에서 복원할 수 있습니다. %3$@%4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Apps samt Restdateien werden in den Papierkorb verschoben; %2$@ lassen sich zurückgewinnen. Restdateien werden zunächst 30 Tage gesichert und lassen sich aus der Sicherung wiederherstellen. %3$@%4$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace %1$@ applications et leurs fichiers restants vers la Corbeille, permettant de récupérer %2$@. Les restants sont d’abord sauvegardés pendant 30 jours et restaurables depuis la sauvegarde.%3$@%4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aplicaciones y sus archivos residuales se moverán a la Papelera; se pueden recuperar %2$@ de espacio. Los residuos se respaldan antes durante 30 días y se pueden restaurar desde el respaldo.%3$@%4$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move %1$@ apps e os resíduos deles para a Lixeira, liberando cerca de %2$@. Os resíduos são primeiro guardados em backup por 30 dias e podem ser restaurados a partir do backup.%3$@%4$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta %1$@ app e i loro file residui nel Cestino, recuperando %2$@ di spazio. I residui vengono prima messi in backup per 30 giorni e si possono ripristinare dal backup. %3$@%4$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения (%1$@) и их остаточные файлы будут перемещены в Корзину, освободится %2$@. Остаточные файлы 30 дней хранятся в резервной копии, из которой их можно восстановить. %3$@%4$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينتقل %1$@ من التطبيقات وملفات بقاياها إلى المهملات، ويمكن استرداد %2$@ من المساحة. تُؤرشف البقايا أولًا لمدة 30 يومًا ويمكن استعادتها من النسخة الاحتياطية. %3$@%4$@"
          }
        }
      }
    },
    "将清理选中的推荐项和可选项，文件将移入废纸篓。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleans the selected recommended and optional items. Files go to the Trash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した推奨項目と任意項目をクリーンアップします。ファイルはゴミ箱へ移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将清理选中的推荐项和可选项，文件将移入废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將清理已勾選的建議項目與可選項目，檔案會移入垃圾桶。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 권장 항목과 선택 항목을 정리합니다. 파일은 휴지통으로 이동됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigt die ausgewählten empfohlenen und optionalen Elemente. Dateien wandern in den Papierkorb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
