    "diskhealth.headline.danger": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. reports a problem — back up and contact Apple Support"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. 报告异常 — 备份并联系 Apple 支持"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. が異常を報告しています — バックアップ後、Apple サポートにご相談ください"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. 回報異常——請備份並聯絡 Apple 支援"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. 이상 보고 — 백업 후 Apple 지원에 문의하세요"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. meldet ein Problem — sichern Sie Ihre Daten und wenden Sie sich an den Apple Support"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. signale un problème — sauvegardez et contactez l’assistance Apple"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. informa de un problema: haz una copia de seguridad y contacta con el Soporte de Apple"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O S.M.A.R.T. reporta um problema — faça backup e contate o Suporte da Apple"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. segnala un problema — fai un backup e contatta il supporto Apple"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "S.M.A.R.T. сообщает о проблеме — сделайте резервную копию и обратитесь в поддержку Apple"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفيد S.M.A.R.T. بوجود مشكلة — خذ نسخة احتياطية وتواصل مع دعم Apple"
          }
        }
      }
