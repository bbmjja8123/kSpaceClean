<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct (Developer ID) channel: no App Sandbox — the app may scan the
	     real home directory once the user grants Full Disk Access in System
	     Settings. All MAS-only keys (App Group, sandbox grants) are absent. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
